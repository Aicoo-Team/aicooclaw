{
  "id": "aicoo",
  "channels": ["aicoo"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Aicoo API key (aicoo_sk_live_...)"
      },
      "baseUrl": {
        "type": "string",
        "format": "uri",
        "description": "Aicoo server URL",
        "default": "https://www.aicoo.io"
      },
      "pollIntervalMs": {
        "type": "number",
        "description": "Message polling interval in milliseconds",
        "default": 3000
      },
      "enabled": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["apiKey", "baseUrl"]
  },
  "uiHints": {
    "apiKey": {
      "label": "API Key",
      "sensitive": true,
      "placeholder": "aicoo_sk_live_..."
    },
    "baseUrl": {
      "label": "Aicoo URL",
      "help": "Your Aicoo instance URL (default: https://www.aicoo.io; local dev: http://localhost:3000)"
    }
  }
}
